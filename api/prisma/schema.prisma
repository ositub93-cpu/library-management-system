generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String   @unique
  totalCopies Int      @default(1)
  genreId     Int
  genre       Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([title, author])
  @@index([genreId])
}